<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/ai_agent/sandbox/*.cs" Link="Sandbox/%(Filename)%(Extension)" />
    <Compile Include="../../src/ai_agent/tools/shell/*.cs" Link="Shell/%(Filename)%(Extension)" />
    <Compile Include="../../examples/SandboxConsole/ConsoleProgress.cs" Link="ConsoleProgress.cs" />
    <Compile Include="../../examples/SandboxConsole/ModelContextPolicy.cs" Link="ModelContextPolicy.cs" />
    <ProjectReference Include="../../src/ai_agent/core/Core.csproj" />
    <ProjectReference Include="../../src/ai_agent/gateway/Gateway.csproj" />
  </ItemGroup>
</Project>
