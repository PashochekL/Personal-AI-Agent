#!/bin/sh
set -eu
invocation_dir=$(pwd -P)
script_path=$0
link_depth=0
while [ -L "$script_path" ]; do
  link_depth=$((link_depth + 1))
  if [ "$link_depth" -gt 32 ]; then printf '%s\n' 'Слишком много ссылок при поиске Дамира.' >&2; exit 1; fi
  script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd -P)
  link_target=$(readlink "$script_path")
  case "$link_target" in /*) script_path=$link_target ;; *) script_path=$script_dir/$link_target ;; esac
done
project_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd -P)
cd "$project_dir"
if [ -z "${DAMIR_TIMEZONE:-}" ]; then
  local_zone=$(readlink /etc/localtime 2>/dev/null || true)
  case "$local_zone" in
    */zoneinfo/*) DAMIR_TIMEZONE=${local_zone#*/zoneinfo/} ;;
    *) DAMIR_TIMEZONE=UTC
       printf '%s\n' 'Не удалось определить часовой пояс компьютера; используется UTC. Можно задать DAMIR_TIMEZONE.' >&2 ;;
  esac
fi
export DAMIR_TIMEZONE
DAMIR_GATEWAY_CONFIG_REV=$(cksum config/litellm.yaml | awk '{print $1 "-" $2}')
export DAMIR_GATEWAY_CONFIG_REV
umask 077
mkdir -p .uv-cache
key_file=.uv-cache/damir-gateway-key
if [ ! -s "$key_file" ]; then
  printf 'sk-%s\n' "$(openssl rand -hex 32)" > "$key_file"
fi
LITELLM_MASTER_KEY=$(cat "$key_file")
export LITELLM_MASTER_KEY
db_key_file=.uv-cache/damir-db-password
if [ ! -s "$db_key_file" ]; then
  openssl rand -hex 32 > "$db_key_file"
fi
DAMIR_POSTGRES_PASSWORD=$(cat "$db_key_file")
export DAMIR_POSTGRES_PASSWORD

case "${1:-run}" in
  auth-check|login)
    printf '%s\n' 'Вход в ChatGPT по коду устройства через LiteLLM.'
    docker compose run --rm --no-deps --user 0 --entrypoint python gateway -c 'import os; os.chown("/tokens/chatgpt", 65532, 65532); os.chmod("/tokens/chatgpt", 0o700)'
    exec docker compose run --rm --no-deps --entrypoint python gateway -u -c 'from litellm.llms.chatgpt.authenticator import Authenticator; Authenticator().get_access_token(); print("Вход завершён. Сессия сохранена в отдельном томе Дамира.")'
    ;;
  run|backend|telegram|telegram-drain)
    if [ "${1:-run}" = telegram ] || [ "${1:-run}" = telegram-drain ]; then
      if [ "$#" -gt 2 ]; then printf '%s\n' 'Использование: damir telegram [--configure]' >&2; exit 2; fi
      . "$project_dir/scripts/telegram-settings.sh"
      damir_configure_telegram "$1" "${2:-}"
    fi
    COMPOSE_PROGRESS=quiet
    COMPOSE_IGNORE_ORPHANS=true
    export COMPOSE_PROGRESS COMPOSE_IGNORE_ORPHANS
    if [ "$invocation_dir" = "$project_dir" ]; then
      DAMIR_WORKSPACE="$project_dir/workspace"
      mkdir -p "$DAMIR_WORKSPACE"
      DAMIR_SESSION_ID=${DAMIR_SESSION_ID:-local}
    else
      DAMIR_WORKSPACE="$invocation_dir"
      workspace_hash=$(printf '%s' "$DAMIR_WORKSPACE" | openssl dgst -sha256 | awk '{print $NF}')
      DAMIR_SESSION_ID=${DAMIR_SESSION_ID:-"workspace-$workspace_hash"}
    fi
    export DAMIR_WORKSPACE DAMIR_SESSION_ID
    # Memory belongs to a project, not to an individual conversation.
    memory_project_hash=$(printf '%s' "$DAMIR_WORKSPACE" | openssl dgst -sha256 | awk '{print $NF}')
    DAMIR_MEMORY_PROJECT=${DAMIR_MEMORY_PROJECT:-"workspace-$memory_project_hash"}
    export DAMIR_MEMORY_PROJECT
    DAMIR_SANDBOX_VOLUME="damir-ipc-$(openssl rand -hex 16)"
    DAMIR_MCP_VOLUME="damir-mcp-$(openssl rand -hex 16)"
    github_credentials() {
      if [ "$(uname -s)" != Darwin ]; then
        printf '%s\n' 'Системное хранилище GitHub пока поддерживается на macOS и Windows.' >&2
        return 1
      fi
      git credential-osxkeychain "$1"
    }
    github_key() { printf 'protocol=https\nhost=damir-github.local\nusername=damir\n\n'; }
    if [ "${1:-run}" != telegram ] && [ -z "${DAMIR_GITHUB_TOKEN:-}" ] && [ "$(uname -s)" = Darwin ]; then
      DAMIR_GITHUB_TOKEN=$(github_key | github_credentials get 2>/dev/null | sed -n 's/^password=//p')
    fi
    DAMIR_GITHUB_MCP=0
    if [ -n "${DAMIR_GITHUB_TOKEN:-}" ]; then DAMIR_GITHUB_MCP=1; fi
    if [ -z "${DAMIR_BACKEND_API_KEY:-}" ]; then
      if [ ! -s .uv-cache/damir-backend-key ]; then openssl rand -hex 32 > .uv-cache/damir-backend-key; fi
      DAMIR_BACKEND_API_KEY=$(cat .uv-cache/damir-backend-key)
    fi
    export DAMIR_BACKEND_API_KEY
    export DAMIR_GITHUB_TOKEN
    export DAMIR_SANDBOX_VOLUME DAMIR_MCP_VOLUME DAMIR_GITHUB_MCP
    sandbox_id=
    github_id=
    backend_id=
    cleanup() {
      if [ -n "$backend_id" ]; then docker stop --time 40 "$backend_id" >/dev/null 2>&1 || true; fi
      if [ -n "$sandbox_id" ]; then docker stop "$sandbox_id" >/dev/null 2>&1 || true; fi
      if [ -n "$github_id" ]; then docker stop "$github_id" >/dev/null 2>&1 || true; fi
      docker volume rm "$DAMIR_SANDBOX_VOLUME" >/dev/null 2>&1 || true
      docker volume rm "$DAMIR_MCP_VOLUME" >/dev/null 2>&1 || true
    }
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    docker compose build web-search
    docker compose up -d --wait gateway postgres web-search
    docker compose up -d --wait redis
    if [ "${DAMIR_MEMORY_ENABLED:-1}" = 1 ]; then
      docker compose up -d --wait memory-db embeddings
      if ! docker compose exec -T embeddings ollama show embeddinggemma:300m >/dev/null 2>&1; then
        docker compose exec -T embeddings ollama pull embeddinggemma:300m
      fi
    fi
    if [ "${1:-run}" = telegram ]; then
      if sh scripts/telegram-isolated.sh; then exit 0; else exit $?; fi
    fi
    docker compose build shell-sandbox
    sandbox_id=$(docker compose run -d --rm --no-deps shell-sandbox)
    if [ "$DAMIR_GITHUB_MCP" = 1 ]; then
      docker compose build github-mcp
      github_id=$(docker compose run -d --rm --no-deps github-mcp)
    fi
    if [ "${1:-run}" = backend ]; then
      printf '%s\n' 'Backend: http://127.0.0.1:8080 (DAMIR_BACKEND_PORT меняет порт). Остановка: Ctrl+C.'
      if docker compose run --no-deps --rm --build --service-ports backend; then exit 0; else exit $?; fi
    fi
    while :; do
      backend_name="damir-backend-${DAMIR_SANDBOX_VOLUME#damir-ipc-}"
      if [ "${1:-run}" = telegram-drain ]; then
        backend_id=$(docker compose run -d --rm --no-deps --build --name "$backend_name" --service-ports backend)
      else backend_id=$(docker compose run -d --rm --no-deps --build --name "$backend_name" backend); fi
      DAMIR_CLI_BACKEND_URL="http://$backend_name:8080"
      export DAMIR_CLI_BACKEND_URL
      client=cli
      if [ "${1:-run}" = telegram-drain ]; then client=telegram-legacy; fi
      if docker compose run --no-deps --rm --build "$client"; then result=0; else result=$?; fi
      docker stop --time 40 "$backend_id" >/dev/null
      backend_id=
      case "$result" in
        71)
          if [ "$(uname -s)" != Darwin ]; then
            printf '%s\n' 'Вход в этом скрипте доступен на macOS; на Windows используй damir.cmd.' >&2
            continue
          fi
          printf '%s' 'Вставь personal access token GitHub (ввод скрыт): '
          trap 'stty echo 2>/dev/null || true; exit 130' INT
          trap 'stty echo 2>/dev/null || true; exit 143' TERM
          stty -echo
          IFS= read -r github_token || github_token=
          stty echo
          trap 'exit 130' INT
          trap 'exit 143' TERM
          printf '\n'
          if [ -z "$github_token" ]; then printf '%s\n' 'Токен не введён.'; continue; fi
          if printf 'protocol=https\nhost=damir-github.local\nusername=damir\npassword=%s\n\n' "$github_token" | github_credentials store; then
            DAMIR_GITHUB_TOKEN=$github_token
            export DAMIR_GITHUB_TOKEN
            github_token=
            if [ -n "$github_id" ]; then docker stop "$github_id" >/dev/null; github_id=; fi
            docker compose build github-mcp
            github_id=$(docker compose run -d --rm --no-deps github-mcp)
            DAMIR_GITHUB_MCP=1
            export DAMIR_GITHUB_MCP
            printf '%s\n' 'Токен сохранён в Связке ключей. Переподключаю GitHub.'
          else
            github_token=
            printf '%s\n' 'Не удалось сохранить токен в Связке ключей.' >&2
          fi
          ;;
        72)
          if github_key | github_credentials erase; then
            DAMIR_GITHUB_TOKEN=
            DAMIR_GITHUB_MCP=0
            export DAMIR_GITHUB_TOKEN DAMIR_GITHUB_MCP
            if [ -n "$github_id" ]; then docker stop "$github_id" >/dev/null; github_id=; fi
            printf '%s\n' 'Дамир отключён от GitHub; токен удалён из Связки ключей.'
          else printf '%s\n' 'Не удалось удалить токен из Связки ключей.' >&2; fi
          ;;
        *) exit "$result" ;;
      esac
    done
    ;;
  *)
    printf '%s\n' 'Использование: damir [login|auth-check|run|backend|telegram|telegram-drain]' >&2
    exit 2
    ;;
esac
