# Service configuration; launchers configure local Docker defaults.
DATABASE_URL=
REDIS_URL=
LITELLM_BASE_URL=
LITELLM_API_KEY=
DEFAULT_MODEL=gpt-6.1-sol
TELEGRAM_BOT_TOKEN=
# Comma-separated private account IDs; isolated servers, memory and files.
TELEGRAM_ALLOWED_USER_IDS=
# Legacy single-ID input is used only when the list above is unset.
TELEGRAM_ALLOWED_USER_ID=

AGENT_MAX_ITERATIONS=20
AGENT_WORKSPACE=./workspace

# Local gateway key is generated by damir and kept in ignored local state.

# Long-term memory; the launchers derive project identity independently of session_id.
DAMIR_MEMORY_ENABLED=1
DAMIR_MEMORY_OWNER=local
DAMIR_MEMORY_PROJECT=
DAMIR_EMBEDDING_DEPLOYMENT=damir-memory-embedding
DAMIR_EMBEDDING_MODEL=ollama/embeddinggemma:300m
DAMIR_EMBEDDING_DIMENSIONS=768

# Queued local backend: damir backend. Launcher creates an ignored key when unset.
DAMIR_BACKEND_API_KEY=
DAMIR_BACKEND_PORT=8080
DAMIR_BACKEND_WORKERS=2
DAMIR_TASK_TIMEOUT_SECONDS=300
