FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /source
COPY src/ai_agent/shared/ src/ai_agent/shared/
COPY src/ai_agent/interfaces/http/ src/ai_agent/interfaces/http/
COPY src/ai_agent/interfaces/telegram/ src/ai_agent/interfaces/telegram/
RUN dotnet publish src/ai_agent/interfaces/telegram/Telegram.csproj -c Release -o /app --disable-build-servers

FROM mcr.microsoft.com/dotnet/runtime:10.0
RUN mkdir /state && chown 65532:65532 /state
WORKDIR /app
COPY --from=build /app/ ./
USER 65532:65532
ENTRYPOINT ["dotnet", "/app/Telegram.dll"]
