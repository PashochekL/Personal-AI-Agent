FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /source
COPY src/ai_agent/shared/ src/ai_agent/shared/
COPY src/ai_agent/interfaces/cli/ src/ai_agent/interfaces/cli/
COPY examples/SandboxConsole/ConsoleInput.cs examples/SandboxConsole/ConsoleInput.cs
COPY examples/SandboxConsole/StartupBanner.cs examples/SandboxConsole/StartupBanner.cs
RUN dotnet publish src/ai_agent/interfaces/cli/Cli.csproj -c Release -o /app --disable-build-servers

FROM mcr.microsoft.com/dotnet/runtime:10.0
WORKDIR /app
COPY --from=build /app/ ./
USER 65532:65532
ENTRYPOINT ["dotnet", "/app/Cli.dll"]
