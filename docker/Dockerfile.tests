FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /source
COPY src/ src/
COPY examples/ examples/
COPY tests/ tests/
COPY config/ config/
COPY damir ./damir
COPY scripts/ scripts/
RUN dotnet run --project tests/ContractTests/ContractTests.csproj
RUN dotnet run --project tests/CoreTests/CoreTests.csproj
RUN dotnet run --project tests/MemoryTests/MemoryTests.csproj
RUN dotnet run --project tests/CliTests/CliTests.csproj
RUN dotnet run --project tests/TelegramTests/TelegramTests.csproj
RUN dotnet run --project tests/ObservabilityTests/ObservabilityTests.csproj
RUN sh tests/LaunchTests/memory-workspace.sh
RUN sh tests/LaunchTests/github-auth.sh
RUN sh tests/LaunchTests/telegram.sh
RUN sh tests/LaunchTests/telegram-settings.sh
