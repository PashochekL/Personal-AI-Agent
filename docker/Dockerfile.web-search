FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /source
COPY examples/WebSearchService/ examples/WebSearchService/
RUN dotnet publish examples/WebSearchService/WebSearchService.csproj -c Release -o /app
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app/ ./
USER 65532:65532
ENTRYPOINT ["dotnet", "/app/WebSearchService.dll"]
